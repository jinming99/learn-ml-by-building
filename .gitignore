# ===== Notebook/Report HTML exports (can be regenerated) =====
# Avoid ignoring all HTML globally; only ignore common Jupyter export patterns
# HTML created by nbconvert or Jupyter UI
*.nbconvert.html
*_nbconvert.html
* - Jupyter Notebook.html
[0-9][0-9]-*.html
# Resource folders produced alongside HTML exports
**/*_files/

# ===== Large data files =====
# Git cannot filter by size in .gitignore. As a policy, do not commit files >1MB.
# Prefer download links or scripts to fetch data.
# The following patterns exclude common data artifacts inside data/ folders.
**/data/**/*.csv
**/data/**/*.tsv
**/data/**/*.xls
**/data/**/*.xlsx
**/data/**/*.parquet
**/data/**/*.feather
**/data/**/*.h5
**/data/**/*.hdf5
**/data/**/*.npz
**/data/**/*.npy
**/data/**/*.pickle
**/data/**/*.joblib
**/data/**/*.zip
**/data/**/*.tar
**/data/**/*.tar.gz
**/data/**/*.tgz
**/data/**/*.gz
**/data/**/*.bz2
**/data/**/*.7z
**/data/**/*.rar
**/data/large/**

# Keep small sample data
!data/sample_datasets/*.csv

# Allow committing data for Project 1 KNN Music Recommender
# (override the global **/data/** ignores above)
!Project 1 KNN Music Recommender/data/
!Project 1 KNN Music Recommender/data/**

# Allow committing Mauna Loa CO2 data for Lecture 10
!Lecture 10 Kernel Methods/data/archive.csv


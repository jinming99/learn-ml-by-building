\newcommand{\marginidea}[1]{\marginnote{\textcolor{LectureTeal}{\sffamily\bfseries DESIGN NOTE}\\[1mm]\textcolor{LectureMuted}{#1}}}
\newcommand{\margincaution}[1]{\marginnote{\textcolor{LectureGold}{\sffamily\bfseries CAUTION}\\[1mm]\textcolor{LectureMuted}{#1}}}

% Numbered captions that stay with non-floating TikZ material.
\newcommand{\FigureCaption}[2]{%
  \refstepcounter{figure}\label{#1}%
  \par\nopagebreak[4]\smallskip{\small\color{LectureMuted}\textbf{\textcolor{LectureTeal}{Figure \thefigure.}}~#2\par}\medskip
}
\newcommand{\TableCaption}[2]{%
  \refstepcounter{table}\label{#1}%
  \par\nopagebreak[4]\smallskip{\small\color{LectureMuted}\textbf{\textcolor{LectureTeal}{Table \thetable.}}~#2\par}\medskip
}

% Quiet end matter that travels with a standalone lecture PDF.
\newcommand{\lectureacknowledgment}[1]{%
  \par\smallskip
  {\footnotesize\color{LectureMuted}%
  \noindent\textcolor{LectureTeal}{\sffamily\bfseries Acknowledgment.} #1\par}%
}

% -----------------------------------------------------------------------------
% Table and figure helpers
% -----------------------------------------------------------------------------
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}
\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcommand{\tablehead}[1]{\textcolor{LectureInk}{\sffamily\bfseries #1}}
\renewcommand{\arraystretch}{1.23}

\tikzset{
  lecture axis/.style={->, >=Stealth, draw=LectureMuted, line width=0.65pt},
  guide/.style={draw=LectureGrid, line width=0.5pt},
  link/.style={-{Stealth[length=2.2mm]}, draw=LectureMuted, line width=0.8pt},
  strong link/.style={-{Stealth[length=2.5mm]}, draw=LectureTeal, line width=1.3pt},
  process/.style={rounded corners=1.5mm, draw=LectureGrid, fill=white, minimum height=12mm, align=center, font=\sffamily\small, inner xsep=3mm},
  data point/.style={circle, draw=white, line width=0.8pt, minimum size=3.4mm, inner sep=0pt},
  query point/.style={star, star points=5, star point ratio=2.3, fill=LectureGold, draw=white, line width=0.8pt, minimum size=6mm, inner sep=0pt},
  pill/.style={rounded corners=4mm, fill=LecturePaper, draw=LectureGrid, inner xsep=3mm, inner ysep=1.2mm, font=\sffamily\footnotesize}
}

\pgfplotsset{
  lecture plot/.style={
    axis line style={draw=LectureMuted},
    tick style={draw=LectureMuted},
    tick label style={font=\footnotesize, color=LectureMuted},
    label style={font=\small, color=LectureInk},
    title style={font=\sffamily\bfseries\small, color=LectureInk},
    grid=major,
    grid style={draw=LectureGrid, line width=0.45pt},
    legend style={draw=none, fill=none, font=\footnotesize, text=LectureInk},
    every axis plot/.append style={line width=1.25pt}
  }
}

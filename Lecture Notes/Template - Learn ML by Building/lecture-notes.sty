% -----------------------------------------------------------------------------
% Boxes
% -----------------------------------------------------------------------------
\newtcolorbox{learningbox}{
  enhanced,
  colback=LecturePaper,
  colframe=LectureGrid,
  boxrule=0.5pt,
  arc=1.2mm,
  left=3mm,right=3mm,top=2.2mm,bottom=2.2mm
}


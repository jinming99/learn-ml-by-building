% -----------------------------------------------------------------------------
% Typography and document chrome
% -----------------------------------------------------------------------------
\addtokomafont{title}{\color{LectureInk}\fontsize{34}{38}\selectfont}
\addtokomafont{subtitle}{\color{LectureMuted}\Large\mdseries}
\addtokomafont{subject}{\color{LectureTeal}\bfseries\sffamily\small}
\addtokomafont{section}{\color{LectureInk}\sffamily}
\addtokomafont{subsection}{\color{LectureTeal}\sffamily}
\addtokomafont{subsubsection}{\color{LectureInk}\sffamily}
\addtokomafont{captionlabel}{\color{LectureTeal}\sffamily\bfseries}
\addtokomafont{pagenumber}{\color{LectureMuted}\sffamily}

\setlength{\parindent}{0pt}
\setlength{\parskip}{0.45em plus 0.15em minus 0.1em}
\setlength{\emergencystretch}{2em}
\setlist[itemize]{leftmargin=1.45em, itemsep=0.18em, topsep=0.35em}
\setlist[enumerate]{itemsep=0.18em, topsep=0.35em}

\hypersetup{
  colorlinks=true,
  linkcolor=LectureTeal,
  urlcolor=LectureBlue,
  citecolor=LecturePurple
}


  enhanced,
  colback=LectureTealLight,
  colframe=LectureTeal,
  boxrule=0pt,
  borderline west={2.2pt}{0pt}{LectureTeal},
  arc=0.8mm,
  left=3mm,right=3mm,top=2.2mm,bottom=2.2mm,
  title={#1},
  fonttitle=\sffamily\bfseries\color{white}
}

